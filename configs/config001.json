{
  "seed": 42,
  "data": {
    "data_dir": "data",
    "val_size": 300,
    "max_train_samples": null,
    "extra_train_sources": []
  },
  "image": {
    "size": 256,
    "augment": {
      "rotate_deg": 10,
      "translate": 0.05,
      "scale": [
        0.9,
        1.1
      ]
    }
  },
  "tokenizer": {
    "max_length": 128
  },
  "encoder": {
    "type": "timm",
    "name": "vit_small_patch16_224.augreg_in21k_ft_in1k",
    "pretrained": true,
    "drop_path_rate": 0.1
  },
  "decoder": {
    "dim": 384,
    "depth": 6,
    "num_heads": 6,
    "mlp_ratio": 4.0,
    "dropout": 0.1
  },
  "train": {
    "batch_size": 32,
    "max_steps": 20000,
    "lr": 0.0003,
    "encoder_lr_scale": 0.1,
    "weight_decay": 0.05,
    "warmup_steps": 500,
    "warmup_init_lr": 0.000001,
    "min_lr_ratio": 0.01,
    "grad_clip": 1.0,
    "label_smoothing": 0.0,
    "amp": true,
    "num_workers": 4,
    "log_every": 50,
    "eval_every": 500,
    "save_every": 1000,
    "keep_last_k": 3
  },
  "eval": {
    "batch_size": 64,
    "num_logged_samples": 32
  },
  "log": {
    "journal_mode": "WAL"
  },
  "submission": {
    "default_smiles": "C"
  }
}
